# ─────────────────────────────────────────────
# Sync Syncthing-Fork with Syncthing (Linux)
# ─────────────────────────────────────────────
syncthing-sync() {
  local ZIP="/storage/emulated/0/backups/syncthing/config.zip"
  local DEST="/storage/440D-FAF7/JUJUUU/Phone Stuff/App Backups/Syncthing"

  echo "\e[36m╔══════════════════════════════════════╗\e[0m"
  echo "\e[36m║        SYNCTHING CONFIG SYNC         ║\e[0m"
  echo "\e[36m╚══════════════════════════════════════╝\e[0m"
  echo ""

  if [[ ! -f "$ZIP" ]]; then
    echo "\e[31m  [FAIL] config.zip not found: $ZIP\e[0m"
    return 1
  fi

  mkdir -p "$DEST"

  echo "\e[36m  --> Removing old Syncthing config...\e[0m"
  rm -rf "$DEST"/*(D)

  echo "\e[36m  --> Extracting new config...\e[0m"
  unzip -o "$ZIP" -d "$DEST" > /dev/null && \
      echo "\e[32m    [OK] Extracted to $DEST\e[0m" || \
      { echo "\e[31m    [FAIL] Extraction failed\e[0m"; return 1; }

  echo "\e[32m\n✔ Syncthing config synced.\e[0m"
}

# ─────────────────────────────────────────────
# Sync RetroArch saves/states/config to SD card backup
# ─────────────────────────────────────────────
retroarch-sync() {
  local SOURCE="/storage/emulated/0/Emulation/Emulators/RetroArch/"
  local DEST="/storage/440D-FAF7/JUJUUU/Phone Stuff/App Backups/RetroArch/"

  echo "\e[36m╔══════════════════════════════════════╗\e[0m"
  echo "\e[36m║            RETROARCH SYNC            ║\e[0m"
  echo "\e[36m╚══════════════════════════════════════╝\e[0m"
  echo ""

  if [[ ! -d "$SOURCE" ]]; then
    echo "\e[31m  [FAIL] Source not found: $SOURCE\e[0m"
    return 1
  fi

  mkdir -p "$DEST"

  # -a = recursive + preserves symlinks, permissions, timestamps, group, owner, device files. -H preserves hard links. -A and -X were tried and removed — this Termux rsync build (3.5.0) lacks libacl/libattr support entirely, so those flags error out ("ACLs are not supported on this client") rather than just being a silent no-op; would've been moot anyway since the exFAT SD card destination can't store either. -vv gives verbose file-by-file output. --delete makes this a true one-to-one mirror: anything removed from SOURCE (e.g. a stale cheat file after a database update) is also removed from DEST, not just left behind as orphaned.
  echo "\e[36m  --> Syncing RetroArch folder...\e[0m"
  rsync -aHvv --delete --info=progress2 "$SOURCE" "$DEST" && \
      echo "\e[32m    [OK] Synced to $DEST\e[0m" || \
      { echo "\e[31m    [FAIL] Sync failed\e[0m"; return 1; }

  echo "\e[32m\n✔ RetroArch sync complete.\e[0m"
}

